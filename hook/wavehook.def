; wavehook.def
;
; KHONG khai bao `LIBRARY <ten>`: file .def se lay ten tu `-OUT:` cua
; link.exe. Neu ghi cung ten, ma build ra ten khac thi linker canh bao
; LNK4070 "directive in .EXP differs from output filename".
;
; Bien dem phai export de injector doc qua ReadProcessMemory. Khong khai bao
; o day thi `__declspec(dllexport)` trong C van du, nhung .def la noi duy
; nhat ma linker khong canh bao trung ten (LNK4197).
EXPORTS
    WaveHook_Install
    WaveHook_InstallAt
    WaveHook_Remove
    WaveHook_IsInstalled
    WaveDrawHook_C
    WaveDrawHook
    WaveProbe_DumpCount
    WaveProbe_ReadFile
    WaveProbe_Enable
    WaveDrawTrampoline
    WaveDrawTrampolineVA
    WaveDrawResumeVA
    WaveProbe_InstallAll
    WaveProbe_RemoveAll
    WaveProbe_Count
    WaveProbe_C
    WaveProbeCommon
    WaveProbeTrampVA
    g_callCount
    g_state
    g_step
    g_probeCount
    g_probeArg0
    g_probeInstalled
    WaveHook_SetColorMode
    WaveHook_GetColorMode
    WaveHook_SetCustomColor
    g_colorMode
    g_lastColorRGB
