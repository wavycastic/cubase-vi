# Generated output
build/

# Derived from Steinberg's Cubase15.exe.
# The English string list IS committed on purpose - it is the reference the
# translation map is written against. The raw XML dump is not: it is a build
# intermediate, it carries all 9 of Steinberg's translations, and
# tools/build.py regenerates it from your own Cubase install in one command.
keys/*
!keys/all_strings.tsv

# Python
__pycache__/
*.pyc
.venv/
venv/

